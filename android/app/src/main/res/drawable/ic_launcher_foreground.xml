<?xml version="1.0" encoding="UTF-8"?>
<!-- The Bask mark on the adaptive icon's foreground layer. Kept in the same
     108 unit coordinates as assets/bask_adaptive_foreground.svg: an outer
     radius of 33 about the centre fills the 66 unit safe zone exactly, so
     no launcher mask can clip any of it. The background layer is the ink
     colour @color/ic_launcher_background. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF095F73"
        android:strokeColor="#FFE8E4DA"
        android:strokeWidth="2"
        android:pathData="M22,54 A32,32 0 1,0 86,54 A32,32 0 1,0 22,54 Z" />
    <path
        android:fillColor="#FF3BB3C9"
        android:pathData="M45,37 L45,71 L73,54 Z" />
</vector>
